# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/aeroschool
DB_USER=aeroschool
DB_PASSWORD=aeroschool

# JWT (minimo 32 caracteres)
JWT_SECRET=change_me_in_production_min_32_chars!!
JWT_EXP_MIN=120

# Seed (desativar em producao)
SEED_ENABLED=true
SEED_BUSINESS=true
SEED_STUDENTS=true
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=admin123
SEED_STUDENT_PASS=aluno123

# Seguranca
AUTH_ALLOW_PUBLIC_ADMIN=false

# Uploads
UPLOAD_DIR=./uploads

# Frontend (dev)
VITE_API_BASE_URL=http://localhost:8080/api
